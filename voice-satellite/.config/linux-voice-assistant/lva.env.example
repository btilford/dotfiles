# Per-machine overrides for the Linux Voice Assistant quadlet.
# Copy to ~/.config/linux-voice-assistant/lva.env (untracked) and edit.
# Any variable from upstream's .env.example works; these are the useful ones.

# Name shown in Home Assistant (default: the hostname).
#CLIENT_NAME=office

# PulseAudio source/sink names: `pactl list short sources` / `sinks`.
# Unset = the session default devices.
#AUDIO_INPUT_DEVICE=
#AUDIO_OUTPUT_DEVICE=

# Wake word (built in): okay_nabu (default), hey_jarvis, hey_mycroft, hey_home_assistant,
# okay_computer, alexa, hey_luna, hey_morgan, choo_choo_homie
#WAKE_MODEL=okay_nabu

# WebRTC processing. Useful for webcam/desk mics near speakers.
#MIC_NOISE_SUPPRESSION=2
#MIC_AUTO_GAIN=15

/.DS_Store
/.claude/settings.local.json
nushell/.config/nushell/history.txt
pi-agent/.pi/agent/models.json

# glab writes its token + volatile timestamps here — never track it.
# Provisioning: `glab auth login` then `mise run glab:config`.
glab-cli/.config/glab-cli/config.yml

# Holds a Google app password for the gmail MCP server, plus a personal address
# and machine-local paths. Provision from config.example.yaml.
docker/.docker/mcp/config.yaml

# aerc's account file: the mail password or token, and the account address, which
# is employer identity under the public-mirror rule. It is INI, so lint:mcp-config
# cannot inspect it — the example uses a cred command so a plaintext password has
# no reason to be there at all. Provision from accounts.conf.example, mode 600.
aerc/.config/aerc/accounts.conf

# gh writes `oauth_token:` into hosts.yml whenever no OS keyring is available,
# so tracking it is a standing leak risk even when it currently looks clean.
# Provision with `gh auth login`.
gh/.config/gh/hosts.yml

# Capture output from `mise run screenshots` — the archived copies live in the
# notes vault, never here.
/build/

# Per-machine notification config (copy of notifications.example.json) — user state,
# never stowed or tracked.
quickshell/.config/quickshell/notifications.json

# Per-machine weather config (copy of weather.example.json). Holds a home lat/lon —
# private infrastructure under the public-mirror rule, exactly like a LAN IP — so the
# real file is provisioned from private-dotfiles and never tracked here.
quickshell/.config/quickshell/weather.json

# Regenerated by nushell/env.nu on every shell start, with the generating host's
# absolute paths baked in (mise.nu carried /Users/btilford on macOS while Arch
# rewrote it to /usr/bin/mise — it ping-ponged between machines forever).
# local.nu is untracked so a secret written there cannot be committed; env.nu
# creates the stub, since config.nu sources all four at parse time.
nushell/.config/nushell/.zoxide.nu
nushell/.config/nushell/carapace.nu
nushell/.config/nushell/mise.nu
nushell/.config/nushell/local.nu

# bless (hex editor) session state — records the last-opened file path, which has
# leaked a client project dir and an absolute home path. Config only; state stays
# local. preferences.xml is still tracked.
bless/.config/bless/history.xml
bless/.config/bless/last.session

# Machine-local config, dropped in beside stowed files (works because stow runs
# with --no-folding: directories are real, only files are symlinks). Reserved here
# so a local file can never be committed by accident; mise-scripts/no-local-values.sh
# is the second barrier.
local.env
scrub.patterns
# `?*.local`, NOT `*.local`: in gitignore `*` matches the empty string, so
# `*.local` also matches a directory literally named `.local` — i.e. every stow
# package's `.local/` tree. Files newly added under commands/.local/bin were
# silently ignored for as long as that rule existed (dotfiles-secrets and
# scrub.patterns.example were both lost that way; already-tracked files were
# unaffected, which is why it went unnoticed). `?` requires one char first.
?*.local
*.local.lua
*.local.toml
*.local.fish
[0-9][0-9]-local
[0-9][0-9]-local.*

# Written by the program that owns them, not by this repo. Each is also listed in
# its package's .stow-local-ignore, so stow never fights the owner for the path.
# The rule: a stow package may only contain files the repo owns end to end.
#
#   wallust.conf   wallust regenerates it on every wallpaper switch
#   fish_variables fish rewrites its own universal-variable store constantly
#   wt.fish        worktrunk installs its own function AND completion, and its
#                  copy is the newer one — ours was a stale fork of it
ghostty/.config/ghostty/wallust.conf
fish/.config/fish/fish_variables
fish/.config/fish/functions/wt.fish
fish/.config/fish/completions/wt.fish

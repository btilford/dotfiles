/.DS_Store
/.claude/settings.local.json
nushell/.config/nushell/history.txt
pi-agent/.pi/agent/models.json

# glab writes its token + volatile timestamps here — never track it.
# Provisioning: `glab auth login` then `mise run glab:config`.
glab-cli/.config/glab-cli/config.yml

# Holds a Google app password for the gmail MCP server, plus a personal address
# and machine-local paths. Provision from config.yaml.example.
docker/.docker/mcp/config.yaml

# gh writes `oauth_token:` into hosts.yml whenever no OS keyring is available,
# so tracking it is a standing leak risk even when it currently looks clean.
# Provision with `gh auth login`.
gh/.config/gh/hosts.yml

# Capture output from `mise run screenshots` — the archived copies live in the
# notes vault, never here.
/build/

# Per-machine notification config (copy of notifications.example.json) — user state,
# never stowed or tracked.
quickshell/.config/quickshell/notifications.json

# Regenerated by nushell/env.nu on every shell start, with the generating host's
# absolute paths baked in (mise.nu carried /Users/btilford on macOS while Arch
# rewrote it to /usr/bin/mise — it ping-ponged between machines forever).
# local.nu is untracked so a secret written there cannot be committed; env.nu
# creates the stub, since config.nu sources all four at parse time.
nushell/.config/nushell/.zoxide.nu
nushell/.config/nushell/carapace.nu
nushell/.config/nushell/mise.nu
nushell/.config/nushell/local.nu

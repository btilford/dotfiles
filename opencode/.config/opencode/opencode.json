{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp",
      "enabled": true
    },
    "obsidian": {
      "type": "local",
      "command": [
        "obsidian-mcp-server"
      ],
      "enabled": true,
      "env": {
        "OBSIDIAN_API_KEY": "***REMOVED***"
      }
    },
    "unifi-network": {
      "type": "local",
      "command": [
        "uvx",
        "unifi-network-mcp@latest"
      ],
      "enabled": true,
      "env": {
        "UNIFI_NETWORK_HOST": "192.0.2.1",
        "UNIFI_NETWORK_USERNAME": "btilford"
      }
    },
    "vault": {
      "type": "local",
      "command": [
        "/home/btilford/.local/share/mise/installs/python/latest/bin/python3",
        "/home/btilford/.local/bin/vault-mcp-server.py"
      ],
      "enabled": true,
      "env": {
        "VAULT_AGENT": "opencode"
      }
    }
  },
  "plugin": [
    "@tarquinen/opencode-dcp@1.2.7",
    "@franlol/opencode-md-table-formatter@0.0.3",
    "@simonwjackson/opencode-direnv",
    "@zenobius/opencode-background",
    "opencode-gemini-auth@latest",
    "opencode-snippets",
    "opencode-plugin-openspec",
    "@plannotator/opencode@latest"
  ],
  "permission": {
    "task": "deny",
    "context7_*": "deny",
    "exa_*": "deny",
    "gh_grep_*": "deny",
    "kagi_*": "deny",
    "webfetch": "deny",
    "worktree_*": "deny",
    "obsidian_*": "allow",
    "unifi_network_*": "allow",
    "vault_*": "allow"
  },
  "provider": {
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",

{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "MCP_DOCKER": {
      "type": "local",
      "command": [
        "docker",
        "mcp",
        "gateway",
        "run"
      ],
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp",
      "enabled": true
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": true
    },
    "obsidian": {
      "type": "local",
      "command": [
        "obsidian-mcp-server"
      ],
      "enabled": true,
      "env": {
        "OBSIDIAN_API_KEY": "***REMOVED***"
      }
    },
    "unifi-network": {
      "type": "local",
      "command": [
        "uvx",
        "unifi-network-mcp@latest"
      ],
      "enabled": true,
      "env": {
        "UNIFI_NETWORK_HOST": "192.0.2.1",
        "UNIFI_NETWORK_USERNAME": "btilford",
        "UNIFI_NETWORK_PASSWORD": "***REMOVED***"
      }
    }
  },
  "plugin": [
    "@tarquinen/opencode-dcp@1.2.7",
    "@franlol/opencode-md-table-formatter@0.0.3",
    "@simonwjackson/opencode-direnv",
    "@zenobius/opencode-background",
    "opencode-gemini-auth@latest",
    "opencode-snippets",
    "opencode-plugin-openspec",
    "@plannotator/opencode@latest"
  ],
  "permission": {
    "task": "deny",
    "context7_*": "deny",
    "exa_*": "deny",
    "gh_grep_*": "deny",
    "kagi_*": "deny",
    "webfetch": "deny",
    "worktree_*": "deny",
    "obsidian_*": "allow"
  },

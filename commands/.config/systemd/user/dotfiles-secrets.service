# Fetch Infisical secrets once per login into the tmpfs session cache.
#
# This unit exists so that NOTHING ELSE has to fetch. Shells read the cache file
# it writes; other user units read the same file via
# `EnvironmentFile=-%t/dotfiles/secrets.env`. A terminal therefore opens at the
# same speed whether infisical is reachable, unreachable, or not installed —
# opening a shell never makes a network call.
#
# Install:
#   systemctl --user daemon-reload
#   systemctl --user enable --now dotfiles-secrets.service
#
# Refresh after rotating a key, without logging out:
#   secrets-refresh          (fish function; same as the line below)
#   systemctl --user restart dotfiles-secrets.service
#
# Check what happened:
#   systemctl --user status dotfiles-secrets.service
#   journalctl --user -u dotfiles-secrets.service -n 20

[Unit]
Description=Fetch Infisical secrets into the session cache
Documentation=man:dotfiles-secrets(1)
# The cache lives in %t (XDG_RUNTIME_DIR), which systemd itself provides, so
# there is no filesystem dependency to declare. Network is a soft ordering only:
# the fetch is already bounded by its own timeout and a failure here is not fatal
# to the session, so a machine that boots offline must not wait on this.
After=network-online.target
Wants=network-online.target
# NO ORDERING AGAINST THE WALLET, deliberately — and the history is worth keeping,
# because the obvious fix is the one that was just removed.
#
# infisical's own `infisical login` stores a USER token in the Secret Service
# (here: ksecretd), and that wallet starts LOCKED. This unit therefore used to
# carry Wants=/After=plasma-kwallet-pam.service — a `static` KDE unit that only
# Plasma's session target pulls in, started by hand here because Hyprland has no
# equivalent. Without it the fetch ran against a locked wallet, infisical exited 1,
# and no cache was written (observed 2026-08-03 18:41:58, and again 2026-08-04
# 17:21:35 even WITH the ordering in place — the unlock is racy, not reliable).
#
# `dotfiles-secrets` now authenticates with a MACHINE IDENTITY when one is
# provisioned: client credentials in ~/.config/dotfiles/infisical-identity are
# exchanged for a short-lived access token over the network call the fetch was
# already making. No local credential store is consulted, so there is nothing to
# unlock and nothing to order against.
#
# On a machine with no identity file the script falls back to the CLI's own vault,
# which is the old behaviour — so this unit can still fail there if the wallet is
# locked. Pair that machine with `infisical vault set file` rather than
# re-adding an ordering dependency on a KDE unit.

# Rate limit for the Restart= in [Service] below — StartLimit* live here, in
# [Unit], not beside the setting they bound.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=oneshot
# The cache must outlive the fetch, and a oneshot without this is "inactive
# (dead)" the moment it exits — which makes `After=dotfiles-secrets.service` on a
# consumer unit meaningless and hides whether the fetch ever succeeded.
RemainAfterExit=yes
ExecStart=%h/.local/bin/dotfiles-secrets --cache

# A machine with no infisical and no INFISICAL_* is a normal, survivable state:
# consumers fall back to point-of-use (`dotfiles-secrets --get`) or go without.
# That case, and only that case, exits 78 (EX_CONFIG, from skip()).
#
# This was `SuccessExitStatus=1` and that was wrong: every failure in the script
# exits 1 — die() is its only exit — so a locked wallet, an unreachable gateway
# and a logged-out CLI all reported success. The unit sat `active` with no cache
# written and nothing anywhere said so. A real failure must now fail the unit.
SuccessExitStatus=78

# BOUNDED retry, added 2026-08-09. This block used to read "No Restart=: retrying a
# locked keyring or a logged-out CLI on a timer just produces a journal full of the
# same failure" — correct for the wallet-token model, and stale the moment machine
# identity replaced it. There is no wallet left to be locked, so the dominant
# remaining failure is the one that IS worth retrying: the fetch beat the network.
# `After=network-online.target` is ordering, not a guarantee the gateway resolves,
# and on this machine DNS is behind netbird, which is still settling at login.
#
# What that cost: the unit failed once at 2026-08-08 14:25:52 and stayed failed for
# 27 hours. Nothing retried and nothing surfaced it. `dotfiles-secrets --cache` run
# by hand afterwards succeeded on the first try in 0.45s — so the machine spent a
# day with no cache purely because one attempt landed too early. The visible symptom
# was NOT a missing secret: it was neovim freezing ~500ms per keystroke, because
# nvim's per-request `--get` fell through the empty cache to the network (see the
# memoisation note in nvim/.config/nvim/lua/plugins/ai.lua).
#
# Bounded, not indefinite: five attempts over ~2min covers a slow network and then
# stops, so a genuinely logged-out or misconfigured machine still lands in `failed`
# where it can be seen, rather than looping in the journal forever. Exit 78 is
# success, so "this machine has no infisical" never retries at all.
Restart=on-failure
RestartSec=20s

[Install]
# default.target, NOT graphical-session.target — reverted along with the wallet
# ordering above, and for the same reason.
#
# It was graphical-session.target because of lingering: with Linger=yes systemd
# starts user@$UID at BOOT, so default.target activates with no PAM session in
# existence and the wallet cannot possibly have been unlocked yet. Measured on
# 2026-08-03: default.target 18:41:58, graphical-session.target 18:42:08. Ten
# seconds, and the whole difference between a locked and an unlocked wallet.
#
# With machine-identity auth there is no wallet in the path, so the early start is
# no longer a problem — it is an advantage. graphical-session.target carried a real
# cost this now removes: a machine that never starts a graphical session (a
# headless box, a pure SSH login) never ran this unit and had no cache at all.
#
# Ordering against network-online.target above is what actually matters for an
# early start, and that is already declared.
WantedBy=default.target

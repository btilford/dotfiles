#!/usr/bin/env python3
"""
sync-litellm-models — single source of truth for LiteLLM model routing.

Fetches the REAL model list from each provider's native /models endpoint and
syncs it to whichever targets exist on THIS machine:

  * gateway  — reconciles the LiteLLM DB (STORE_MODEL_IN_DB=true) to exactly the
               real models, removing the openai/* wildcards that pollute
               GET /v1/models with 600+ junk entries (every OpenAI registry
               model stamped under each prefix). Fixes Hermes and any client
               that lists models from the gateway.
  * pi       — rewrites the catalog in ~/.pi/agent/models.json
  * opencode — rewrites the picker in
               ~/dotfiles/opencode/.config/opencode/opencode.json

Not every machine has the same agents installed, so targets are auto-detected
and (when run interactively without flags) confirmed before any change.

Why explicit ids instead of wildcards: wildcards route any suffix but make
/v1/models return the whole OpenAI registry per prefix. Registering the real
ids gives a clean, accurate list everywhere. Trade-off: a brand-new model on a
provider isn't routable until this re-runs — which is one command.

Secrets come from Infisical (same project as the rest of the homelab).

Examples:
  sync-litellm-models                 # detect targets, confirm, sync
  sync-litellm-models --yes           # sync all detected targets, no prompt
  sync-litellm-models --only gateway  # just reconcile the LiteLLM DB
  sync-litellm-models --only pi,opencode
  sync-litellm-models --dry-run       # show planned changes, touch nothing
"""
from __future__ import annotations
import argparse
import json
import os
import shutil
import subprocess
import sys
import urllib.error
import urllib.request
from pathlib import Path

# Infrastructure identifiers are machine-local — set them in
# ~/.config/fish/conf.d/local.fish (untracked), not here:
#
#   set -gx INFISICAL_PROJECT <uuid>
#   set -gx INFISICAL_DOMAIN  https://infisical.example.com
#   set -gx LITELLM_GATEWAY   https://litellm.example.com
#
# The two LAN model hosts default to localhost, so a machine that runs neither
# still works — those providers just report unreachable and keep their entries:
#
#   set -gx LEMONADE_URL      http://<host>:13305
#   set -gx OLLAMA_URL        http://<host>:11434


def _require_env(name: str) -> str:
    val = os.environ.get(name)
    if not val:
        raise SystemExit(
            f"{name} is not set — see the comment at the top of this script.")
    return val


INFISICAL_PROJECT = _require_env("INFISICAL_PROJECT")
INFISICAL_DOMAIN = _require_env("INFISICAL_DOMAIN")
GATEWAY = _require_env("LITELLM_GATEWAY")
LEMONADE_URL = os.environ.get("LEMONADE_URL", "http://localhost:13305")
OLLAMA_URL = os.environ.get("OLLAMA_URL", "http://localhost:11434")
TIMEOUT = 20

# --- model naming ---------------------------------------------------------
#
# A model name is "<where it runs>/<model id>". For a local runner the prefix is
# "<host>.<runner>", so two runners on ONE box stay distinguishable — which is
# the whole point once llama-swap sits beside Lemonade on the same machine.
#
# Use "." between host and runner, never "-": hostnames contain hyphens
# already, so "<host>-<runner>" cannot be parsed back apart. Keep exactly ONE
# "/" — some OpenAI clients split the model string on the first slash.
#
# The host half is machine-local and comes from the environment, because this
# file is published and a hostname is infrastructure disclosure. The fallback is
# the bare runner name, which is safe to publish and still correct — it only
# loses the host qualifier on a machine that has not set the variable.
#
# `or` rather than a get() default on purpose: an empty value in local.env must
# behave as unset. A get() default would yield a prefix of "" and silently
# produce model names beginning with "/". Same class of bug as the empty
# ATUIN_* variables documented in the repo CLAUDE.md.
LEMONADE_PREFIX = os.environ.get("DOTFILES_LEMONADE_PREFIX") or "lemonade"
OLLAMA_PREFIX = os.environ.get("DOTFILES_OLLAMA_PREFIX") or "ollama"
LLAMASWAP_PREFIX = os.environ.get("DOTFILES_LLAMASWAP_PREFIX") or "llamaswap"

# llama-swap is the replacement for Lemonade: it holds several models resident
# at once, which Lemonade cannot (max_models.llm = 1). Both are registered
# during the migration so nothing breaks while roles move across.
LLAMASWAP_URL = os.environ.get("LLAMASWAP_URL") or "http://localhost:8090"

# --- role aliases ---------------------------------------------------------
#
# Consumers (nvim, atuin, agents with a fixed config) reference a ROLE, never a
# concrete model. The role is a stable name; what it resolves to changes freely
# as models are benchmarked and replaced.
#
# This exists because the concrete names are not stable and never will be. The
# `local/qwen2.5-coder-7b` that nvim still points at was real once and vanished
# when the gateway's model DB was rebuilt — inline completion has been dead ever
# since, silently. A role alias turns that class of breakage into one line here
# instead of a grep across every agent config.
#
# It also keeps hostnames out of published config: "role/completion" discloses
# nothing, so the tracked dotfiles never name a machine.
#
# Values are concrete model names as registered below. A role whose target is
# not currently registered is skipped with a warning rather than failing the
# run, so an unreachable provider cannot take the whole sync down.
#
# Targets must live on an ALWAYS-ON host. The Ollama workstation is powered off
# routinely, and an unreachable provider means the alias is skipped on that run —
# so a role pointed there would vanish and reappear, taking inline completion
# down intermittently with no visible cause. Everything below therefore resolves
# on the Lemonade box.
#
# role/completion is a placeholder and a known-bad one. Lemonade serves exactly
# one LLM at a time (`max_models.llm = 1`), so completion and reasoning evict
# each other on every alternating request. There is also no small FIM-capable
# coder on that host yet — the smallest is 17 GiB. Both problems are fixed by
# the same change: llama-swap, which can hold the two warm together.
#
# completion and assistant are on llama-swap, which holds both resident at once
# (0.18 s warm, versus a cold reload on every alternating request under
# Lemonade's one-model limit).
#
# All three roles now resolve on llama-swap. LEMONADE IS NO LONGER IN THE PATH
# and can be retired, freeing its ~530 GB private store.
#
# reasoning was blocked for a while on `missing tensor blk.40.ssm_conv1d.weight`,
# which looked like a model or kernel problem and was neither: the toolbox image
# was pinned to the ABANDONED rocm-7.2.1 tag at llama.cpp b8940 while upstream
# was at b10235. Switching to the maintained rocm-7.14 tag fixed it outright.
ROLE_ALIASES = {
    "role/completion": f"{LLAMASWAP_PREFIX}/qwen2.5-coder-7b",
    # NOT gemma3. Gemma's chat template enforces strict user/assistant
    # alternation and rejects consecutive user messages with
    # "Conversation roles must alternate user/assistant/...". atuin-ai sends
    # context and query as two user messages, so Gemma can never serve this
    # role however it is configured. Verified: system+user succeeds on gemma3,
    # system+user+user fails on gemma3 and succeeds on qwen.
    #
    # qwen2.5-coder-7b is already warm for role/completion, so this costs no
    # extra memory. Qwen3-4B-Instruct-2507 is the better long-term choice
    # (Apache 2.0, CLI-heavy training, 2.4 GB) once imported from Lemonade.
    "role/assistant": f"{LLAMASWAP_PREFIX}/qwen3-4b-instruct",
    "role/reasoning": f"{LLAMASWAP_PREFIX}/qwen3.6-35b-mtp",
}

HOME = Path.home()
PI_MODELS = HOME / ".pi/agent/models.json"
OPENCODE_JSON = HOME / ".config/opencode/opencode.jsonc"


# --- helpers --------------------------------------------------------------

def infisical(name: str) -> str:
    """Environment first, Infisical only as a fallback.

    dotfiles-secrets.service already caches every secret this script needs into
    $XDG_RUNTIME_DIR/dotfiles/secrets.env at login, and every shell exports it —
    so in a normal terminal this returns immediately with no network call.

    The fallback matters for auth, not just speed. dotfiles-secrets authenticates
    with the machine identity in ~/.config/dotfiles/infisical-identity, which has
    no expiry and touches no keyring. A bare `infisical secrets get` does NOT: it
    consults the CLI's own vault, i.e. the user token from `infisical login`, which
    lives in the OS keyring and expires. Reaching the CLI path therefore fails on a
    machine that has never run `infisical login`, or whose login has aged out, even
    though the identity is perfectly valid — so prefer the environment, and route
    the fallback through dotfiles-secrets where it exists.
    """
    val = os.environ.get(name, "").strip()
    if val:
        return val

    if shutil.which("dotfiles-secrets"):
        out = subprocess.run(["dotfiles-secrets", "--get", name],
                             capture_output=True, text=True, timeout=30)
        val = out.stdout.strip()
        if val:
            return val

    out = subprocess.run(
        ["infisical", "secrets", "get", name,
         "--projectId", INFISICAL_PROJECT, "--env", "prod",
         "--domain", INFISICAL_DOMAIN, "--plain", "--silent"],
        capture_output=True, text=True, timeout=30)
    val = out.stdout.strip()
    if not val:
        raise SystemExit(
            f"Infisical: could not read {name}. Tried $={name}, dotfiles-secrets, "
            f"then the CLI directly — the last needs `infisical login`, which the "
            f"machine identity deliberately replaces. Try: "
            f"systemctl --user restart dotfiles-secrets.service")
    return val


def http_json(url, *, token=None, method="GET", body=None) -> dict:
    # Some providers (OpenCode Zen) 403 the default Python urllib User-Agent.
    headers = {"Content-Type": "application/json", "User-Agent": "curl/8"}
    if token:
        headers["Authorization"] = f"Bearer {token}"
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(url, data=data, headers=headers, method=method)
    with urllib.request.urlopen(req, timeout=TIMEOUT) as r:
        return json.loads(r.read() or "{}")


def gateway_reachable(master) -> bool:
    try:
        http_json(f"{GATEWAY}/health/readiness")
        return True
    except Exception:
        return False


# --- provider definitions -------------------------------------------------

def provider_specs(keys) -> list[dict]:
    return [
        {"prefix": "venice", "label": "Venice",
         "models_url": "https://api.venice.ai/api/v1/models?type=text",
         "token": keys["VENICE"],
         "litellm": lambda mid: {"model": f"openai/{mid}",
                                 "api_base": "https://api.venice.ai/api/v1",
                                 "api_key": keys["VENICE"]}},
        {"prefix": "zen", "label": "Zen",
         "models_url": "https://opencode.ai/zen/v1/models",
         "token": keys["ZEN"],
         "litellm": lambda mid: {"model": f"openai/{mid}",
                                 "api_base": "https://opencode.ai/zen/v1",
                                 "api_key": keys["ZEN"]}},
        {"prefix": LEMONADE_PREFIX, "label": "Lemonade",
         "models_url": f"{LEMONADE_URL}/v1/models", "token": None,
         "litellm": lambda mid: {"model": f"openai/{mid}",
                                 "api_base": f"{LEMONADE_URL}/v1",
                                 "api_key": "none"}},
        {"prefix": LLAMASWAP_PREFIX, "label": "llama-swap",
         "models_url": f"{LLAMASWAP_URL}/v1/models", "token": None,
         "litellm": lambda mid: {"model": f"openai/{mid}",
                                 "api_base": f"{LLAMASWAP_URL}/v1",
                                 "api_key": "none"}},
        {"prefix": OLLAMA_PREFIX, "label": "Ollama",
         "models_url": f"{OLLAMA_URL}/v1/models", "token": None,
         "litellm": lambda mid: {"model": f"ollama/{mid}",
                                 "api_base": OLLAMA_URL,
                                 "api_key": "none"}},
    ]


def fetch_provider(spec) -> tuple[list[str], bool]:
    try:
        data = http_json(spec["models_url"], token=spec["token"])
    except Exception as e:
        print(f"  ! {spec['label']} unreachable ({e}) — keeping its entries")
        return [], False
    return [m["id"] for m in data.get("data", [])], True


# --- gateway reconciliation ----------------------------------------------

def sync_gateway(specs, fetched, master, dry_run):
    desired = {}
    for spec in specs:
        ids, ok = fetched[spec["prefix"]]
        if ok:
            for mid in ids:
                desired[f"{spec['prefix']}/{mid}"] = spec["litellm"](mid)

    # Role aliases resolve to the SAME upstream params as their target, rather
    # than chaining a gateway call through a second gateway entry. One hop, and
    # a role cannot be left pointing at a model that is itself an alias.
    #
    # A role whose target is missing (provider offline this run, or the model
    # was renamed upstream) is reported and skipped. Failing the whole sync
    # instead would mean one dead model takes down every other route.
    for role, target in ROLE_ALIASES.items():
        params = desired.get(target)
        if params is None:
            print(f"  ! {role} -> {target} not registered — skipping alias")
            continue
        desired[role] = params

    # Role names are never deleted by the reconciliation below, because it only
    # considers names whose prefix matches a provider that was reachable, and
    # "role" is not a provider. Stated explicitly so a future change to the
    # delete predicate does not quietly start garbage-collecting them.

    def current_map():
        info = http_json(f"{GATEWAY}/model/info", token=master)
        return {m.get("model_name"): m.get("model_info", {}).get("id")
                for m in info.get("data", [])}

    reachable = {s["prefix"] for s in specs if fetched[s["prefix"]][1]}
    current = current_map()

    # Only touch a provider's entries when that provider was reachable this run,
    # so an offline provider keeps its existing routes (incl. its wildcard).
    to_delete = {n: i for n, i in current.items()
                 if (n[:-2] if n.endswith("/*") else n.split("/", 1)[0]) in reachable
                 and n not in desired}

    print(f"  gateway: desired {len(desired)}, current {len(current)}, "
          f"-{len(to_delete)} stale/wildcard")
    if dry_run:
        for n in list(to_delete)[:4]:
            print(f"    - {n}")
        # adds can't be computed reliably until wildcards are gone (phantoms)
        print(f"    (+ up to {len(desired)} real models after wildcard removal)")
        return

    for mid in filter(None, to_delete.values()):
        try:
            http_json(f"{GATEWAY}/model/delete", token=master,
                      method="POST", body={"id": mid})
        except urllib.error.HTTPError:
            pass

    # Re-fetch AFTER deleting wildcards so phantom expansions are gone; only
    # then are the genuinely-registered model_names trustworthy for dedup.
    current = current_map()

    # Reconcile by VALUE, not by presence.
    #
    # This function used to be add-if-missing throughout, on the assumption that
    # a model_name pins everything about an entry. It does not — `api_base` and
    # `model` can both change under a stable name, and when they do the sync
    # silently did nothing and still reported success. Seen twice in one day:
    #
    #   * role/* kept pointing at Lemonade after their targets moved to
    #     llama-swap — which defeats the entire purpose of a role alias;
    #   * every llama-swap entry kept api_base=localhost:8090 after
    #     LLAMASWAP_URL changed to the LAN address, so the gateway was pointing
    #     at itself.
    #
    # Anything whose registered params differ from what we want is deleted here
    # and recreated by the add pass below. Comparing only the keys we set, so a
    # field LiteLLM adds server-side does not cause an infinite rebuild.
    def params_differ(name, want):
        have = current_params.get(name)
        if have is None:
            return False
        return any(str(have.get(k)) != str(v) for k, v in want.items()
                   if k in ("model", "api_base"))

    info = http_json(f"{GATEWAY}/model/info", token=master)
    current_params = {m.get("model_name"): (m.get("litellm_params") or {})
                      for m in info.get("data", [])}

    outdated = {n: current[n] for n, p in desired.items()
                if n in current and params_differ(n, p)}
    for mid in filter(None, outdated.values()):
        try:
            http_json(f"{GATEWAY}/model/delete", token=master,
                      method="POST", body={"id": mid})
        except urllib.error.HTTPError:
            pass
    if outdated:
        print(f"  retargeted: {len(outdated)} entr(ies) whose params changed")
        current = current_map()

    to_add = {n: p for n, p in desired.items() if n not in current}
    for name, params in to_add.items():
        http_json(f"{GATEWAY}/model/new", token=master, method="POST",
                  body={"model_name": name, "litellm_params": params})
    print(f"  gateway reconciled: +{len(to_add)} real models.")


# --- client configs -------------------------------------------------------

def catalog(specs, fetched):
    # Roles first, so the picker's top entries are the stable names that follow
    # whichever model currently wins its benchmark. Only roles whose target is
    # actually available this run are offered.
    available = set()
    for spec in specs:
        ids, ok = fetched[spec["prefix"]]
        if ok:
            available |= {f"{spec['prefix']}/{mid}" for mid in ids}

    out = [(role, "Role") for role, target in ROLE_ALIASES.items()
           if target in available]
    for spec in specs:
        ids, ok = fetched[spec["prefix"]]
        if ok:
            out += [(f"{spec['prefix']}/{mid}", spec["label"]) for mid in ids]
    return out


def sync_pi(entries, dry_run):
    cfg = json.loads(PI_MODELS.read_text())
    cfg["providers"]["litellm"]["models"] = [
        {"id": mid, "name": f"{mid.split('/', 1)[1]} ({label})"}
        for mid, label in entries]
    print(f"  pi: {len(entries)} models -> {PI_MODELS}")
    if not dry_run:
        PI_MODELS.write_text(json.dumps(cfg, indent=2) + "\n")


def sync_opencode(entries, dry_run):
    cfg = json.loads(OPENCODE_JSON.read_text())
    prov = cfg.get("provider", {}).get("litellm")
    if not prov:
        print("  opencode: no litellm provider — skip")
        return
    prov["models"] = {
        mid: {"name": mid, "displayName": f"{mid.split('/', 1)[1]} ({label})",
              "modelId": mid, "type": "chat"}
        for mid, label in entries}
    print(f"  opencode: {len(entries)} models -> {OPENCODE_JSON}")
    if not dry_run:
        OPENCODE_JSON.write_text(json.dumps(cfg, indent=2) + "\n")


# --- target detection + selection ----------------------------------------

def detect_targets(master):
    t = {}
    t["gateway"] = gateway_reachable(master)
    t["pi"] = PI_MODELS.exists()
    t["opencode"] = OPENCODE_JSON.exists()
    return t


def select_targets(detected, args):
    avail = [k for k, v in detected.items() if v]
    if not avail:
        raise SystemExit("No sync targets detected on this machine.")
    if args.only:
        want = [x.strip() for x in args.only.split(",")]
        bad = [x for x in want if x not in detected]
        if bad:
            raise SystemExit(f"Unknown target(s): {bad}. Known: {list(detected)}")
        missing = [x for x in want if not detected[x]]
        if missing:
            print(f"  note: requested but not detected here: {missing}")
        return [x for x in want if detected[x]]
    if args.yes or not sys.stdin.isatty():
        return avail
    print("Detected targets:", ", ".join(avail))
    chosen = []
    for name in avail:
        ans = input(f"  sync {name}? [Y/n] ").strip().lower()
        if ans in ("", "y", "yes"):
            chosen.append(name)
    return chosen


def main():
    ap = argparse.ArgumentParser(description="Sync real provider models to LiteLLM + agents.")
    ap.add_argument("--only", help="comma list: gateway,pi,opencode")
    ap.add_argument("--yes", "-y", action="store_true", help="no prompt; all detected")
    ap.add_argument("--dry-run", action="store_true")
    args = ap.parse_args()

    keys = {"VENICE": infisical("VENICE_API_KEY"), "ZEN": infisical("ZEN_API_KEY")}
    master = infisical("LITELLM_MASTER_KEY")

    detected = detect_targets(master)
    targets = select_targets(detected, args)
    if not targets:
        print("Nothing selected.")
        return
    print("Syncing:", ", ".join(targets))

    specs = provider_specs(keys)
    print("Fetching provider model lists...")
    fetched = {}
    for spec in specs:
        ids, ok = fetch_provider(spec)
        fetched[spec["prefix"]] = (ids, ok)
        if ok:
            print(f"  {spec['label']}: {len(ids)} models")

    if "gateway" in targets:
        sync_gateway(specs, fetched, master, args.dry_run)
    entries = catalog(specs, fetched)
    if "pi" in targets:
        sync_pi(entries, args.dry_run)
    if "opencode" in targets:
        sync_opencode(entries, args.dry_run)

    print("Dry run — nothing changed." if args.dry_run else "Done.")


if __name__ == "__main__":
    main()

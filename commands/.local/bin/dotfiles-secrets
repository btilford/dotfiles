#!/usr/bin/env sh
# Fetch a secret from Infisical at the moment it is needed.
#
#   dotfiles-secrets --get NAME     print one secret to stdout
#   dotfiles-secrets --dotenv       print every secret as KEY=VALUE (for eval)
#   dotfiles-secrets --run -- CMD   run CMD with the secrets in ITS environment
#   dotfiles-secrets --cache        fetch ONCE per login into the session cache
#   dotfiles-secrets --cache-path   print where that cache lives (no fetch)
#   dotfiles-secrets --list         names only, never values
#   dotfiles-secrets --check        is this machine able to fetch at all
#
# Why a login-time session cache, and not an infisical call per shell:
#
# A secret in the environment has to get there somehow. Calling infisical from
# conf.d is the route that must never be taken: it is a network round trip on
# every new terminal, and it HANGS the shell when the daemon is unreachable or
# the keyring is locked. Checking token validity first is not a way out — the CLI
# has no local expiry check (`infisical token` only renews universal-auth tokens,
# over the network) and the user token lives in the OS keyring, so even reading
# it can raise an unlock prompt.
#
# The fix is to move the fetch off the shell's path entirely rather than to make
# every consumer fetch for itself. ONE oneshot systemd user unit fetches at login
# (dotfiles-secrets.service) and writes the result to
#
#   $XDG_RUNTIME_DIR/dotfiles/secrets.env      dir 0700, file 0600
#
# A shell then does a plain read of a small local file: no network, no infisical,
# no keyring, nothing that can block. A terminal opens at the same speed whether
# the gateway is up, down, or was never configured on this machine.
#
# "Caching to disk writes the secret to a file" — which is why this is NOT disk.
# $XDG_RUNTIME_DIR is /run/user/$UID, a tmpfs: the bytes live in memory, the
# kernel destroys the mount at logout, and nothing survives a reboot. There is no
# file to forget about, no backup that picks it up, and no git history to scrub.
#
# The honest cost, stated plainly because it is a real reversal of the earlier
# design: secrets are now in the environment of EVERY shell and everything a
# shell spawns, not just a command you named. Same-user exposure only — the mode
# bits stop other users and root could read the process memory regardless — but
# it is strictly more surface than point-of-use was. It buys the thing that
# forced it: consumers that can only take an environment variable (clipborg
# expands ${ENV} at config load and hard-errors on an unset one; opencode, aider
# and nvim are the same shape) work in a plain terminal and in a systemd user
# unit without every entry point being wrapped.
#
# The point-of-use paths remain, and remain preferable for anything that does not
# need the variable ambiently:
#
#   --run -- CMD   the secrets live in that ONE process's environment and vanish
#                  with it. Nothing leaks into the shell or its children beyond
#                  the command you named.
#   --get NAME     one value, at the moment it is used.
#
# Systemd user units read the same cache with
# `EnvironmentFile=-%t/dotfiles/secrets.env` — the leading `-` keeps the unit
# startable on a machine that has no secrets at all.
#
# Every failure is both printed to stderr and appended to the log (see LOG), with
# the reason distinguished — a caller that gets nothing should never have to guess
# whether infisical is missing, unconfigured, unreachable, logged out, or simply
# does not have that secret. Values are never logged.

set -u

timeout_s="${DOTFILES_SECRETS_TIMEOUT:-10}"
env_file="${DOTFILES_LOCAL_ENV:-$HOME/.config/dotfiles/local.env}"
log="${DOTFILES_SECRETS_LOG:-${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles/secrets.log}"

# The session cache. Deliberately under XDG_RUNTIME_DIR (tmpfs, 0700, destroyed at
# logout) and never under XDG_STATE_HOME or XDG_CACHE_HOME, which are real disk and
# survive reboots. The fallback keeps the path *inside* a directory only this user
# can enter, for the odd session with no XDG_RUNTIME_DIR — a cron job, a container,
# a bare `ssh host command`. It is a worse location, so `--cache` says so out loud
# rather than silently writing a secret onto disk.
cache_dir="${XDG_RUNTIME_DIR:-}"
cache_on_tmpfs=1
if [ -z "$cache_dir" ]; then
  cache_dir="$HOME/.local/state"
  cache_on_tmpfs=0
fi
cache_file="${DOTFILES_SECRETS_CACHE:-$cache_dir/dotfiles/secrets.env}"

# stderr AND a log file: the important caller is nvim, which swallows stderr, so a
# failure there would otherwise be a silent "missing key" with no trace anywhere.
note() {
  printf '[dotfiles-secrets] %s\n' "$1" >&2
  if mkdir -p "$(dirname "$log")" 2> /dev/null; then
    printf '%s %s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$1" >> "$log" 2> /dev/null || true
  fi
}

die() {
  note "$1"
  exit 1
}

# "This machine is not set up for secrets" is NOT the same failure as "it is set
# up and the fetch failed", and the difference has to survive into an exit code
# because the only consumer that can act on it is systemd, which sees nothing else.
#
# dotfiles-secrets.service marks 78 (EX_CONFIG) as success, so a machine with no
# infisical and no INFISICAL_* stays green at login — that was always the intent.
# It marked *1* as success before, which meant every real failure was reported as
# success too: on 2026-08-03 the login fetch failed against a locked wallet, the
# unit logged "Finished" and sat `active` with no cache written, and the first
# sign of trouble was git-spice failing hours later with an unrelated-looking
# message. A unit that cannot fail cannot tell you anything.
skip() {
  note "$1"
  exit 78
}

value_from_env_file() {
  [ -r "$env_file" ] || return 1
  sed -nE "s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*(.*)$/\1/p" "$env_file" | head -1
}

# Bounded and non-interactive, always. </dev/null so the CLI can never sit waiting
# on a prompt, and `timeout` so an unreachable host cannot stall a caller. Without
# `timeout` (older macOS) the call still cannot prompt, only take longer.
infisical_run() {
  if command -v timeout > /dev/null 2>&1; then
    timeout "$timeout_s" infisical "$@" < /dev/null 2> /dev/null
  else
    infisical "$@" < /dev/null 2> /dev/null
  fi
}

require_setup() {
  command -v infisical > /dev/null 2>&1 || skip "infisical is not installed — cannot fetch secrets"

  domain="${INFISICAL_DOMAIN:-$(value_from_env_file INFISICAL_DOMAIN || true)}"
  project="${INFISICAL_PROJECT:-$(value_from_env_file INFISICAL_PROJECT || true)}"
  # ALWAYS pass --env explicitly. The CLI defaults to "dev", and this project
  # keeps its real values in "prod" — so every command here silently read the
  # wrong environment, which does not fail: it returns a DIFFERENT, smaller set
  # of secrets. Observed 2026-08-03: `--dotenv` returned ten dev-only names
  # (LITELLM_KEY_*) while `secrets get PI_API_KEY --env prod` returned a live key,
  # which reads as "that secret does not exist" rather than "you are looking in
  # the wrong environment".
  infisical_env="${INFISICAL_ENV:-$(value_from_env_file INFISICAL_ENV || true)}"
  [ -n "$infisical_env" ] || infisical_env="prod"

  [ -n "$domain" ] || skip "INFISICAL_DOMAIN is unset and not in $env_file"
  [ -n "$project" ] || skip "INFISICAL_PROJECT is unset and not in $env_file"
}

cmd_get() {
  name="$1"
  [ -n "$name" ] || die "--get needs a secret name"
  require_setup

  out=$(infisical_run secrets get "$name" --plain --silent \
    --domain="$domain" --projectId="$project" --env="$infisical_env")
  rc=$?

  if [ "$rc" -eq 124 ]; then
    die "timed out after ${timeout_s}s fetching $name — infisical unreachable?"
  fi
  if [ "$rc" -ne 0 ]; then
    die "infisical failed fetching $name (exit $rc) — logged in? try: infisical login"
  fi
  # Strip ANSI escapes and any other non-printable bytes.
  #
  # `--plain --silent` is NOT sufficient: infisical still emits cursor-control
  # sequences intermittently (observed 2026-08-02 — a 32-character token came
  # back with 40 extra bytes of "\033[1A\033[2K\r" and "\033[?25h"). It is
  # intermittent, so it survives casual testing.
  #
  # The consequence is nasty precisely because it does not look like a secrets
  # problem: curl rejects a header containing them with
  # "curl: (43) A libcurl function was given a bad argument" and reports
  # http_code 000, which is indistinguishable from a network failure. That sent
  # an afternoon of debugging at a firewall that was fine.
  #
  # Callers get a clean value or nothing.
  out=$(printf '%s' "$out" | sed 's/\x1b\[[0-9;?]*[a-zA-Z]//g' | tr -cd '[:print:]')

  if [ -z "$out" ]; then
    die "infisical returned nothing for $name — does that secret exist in the project?"
  fi

  printf '%s\n' "$out"
}

cmd_dotenv() {
  require_setup
  out=$(infisical_run export --format=dotenv --domain="$domain" --projectId="$project" --env="$infisical_env")
  rc=$?
  [ "$rc" -eq 124 ] && die "timed out after ${timeout_s}s exporting secrets"
  [ "$rc" -eq 0 ] || die "infisical failed exporting secrets (exit $rc) — logged in? try: infisical login"
  [ -n "$out" ] || die "infisical returned no secrets for this project"
  printf '%s\n' "$out"
}

# infisical's own `run` injects into the child process and nothing else, which is
# exactly the guarantee wanted here — so this is a thin wrapper, not a
# reimplementation. No timeout: CMD is interactive and long-lived by nature.
cmd_run() {
  [ "$#" -gt 0 ] || die "--run needs a command, e.g. --run -- opencode"
  require_setup
  exec infisical run --domain="$domain" --projectId="$project" --env="$infisical_env" -- "$@"
}

# Fetch once and leave the result where shells and systemd units can read it
# without touching the network. Called by dotfiles-secrets.service at login, and
# by hand as `secrets-refresh` after rotating a key.
#
# Written via a temp file in the SAME directory and then renamed, so a reader
# never sees a half-written cache: rename(2) within one filesystem is atomic, and
# a shell sourcing this file mid-write would otherwise export a truncated value.
# The temp file is created with the final mode already applied — creating it 0644
# and chmod-ing after leaves a window where the secret is world-readable.
cmd_cache() {
  if [ "$cache_on_tmpfs" -eq 0 ]; then
    note "no XDG_RUNTIME_DIR — caching to $cache_file, which is real disk and survives reboot"
  fi

  dir=$(dirname "$cache_file")
  mkdir -p "$dir" || die "cannot create $dir"
  chmod 700 "$dir" 2> /dev/null || true

  # Fetch BEFORE touching the cache. A failed refresh must leave the previous
  # cache intact — a locked keyring at 09:00 should not empty the environment of
  # every terminal opened after it.
  #
  # Propagate cmd_dotenv's OWN status rather than a flat 1: `|| exit 1` would
  # rewrite skip()'s 78 into a hard failure and put the unit back to failing on
  # machines that simply have no secrets configured.
  out=$(cmd_dotenv) || exit $?

  tmp="$cache_file.$$"
  (
    umask 077
    printf '%s\n' "$out" > "$tmp"
  ) || die "cannot write $tmp"
  chmod 600 "$tmp" 2> /dev/null || true
  mv -f "$tmp" "$cache_file" || {
    rm -f "$tmp"
    die "cannot install $cache_file"
  }

  # Count, never names and never values: this runs at login and its output lands
  # in the journal, which is not a place a secret name list needs to be either.
  n=$(printf '%s\n' "$out" | grep -c '^[A-Za-z_][A-Za-z0-9_]*=' || true)
  note "cached $n secret(s) to $cache_file"
}

cmd_cache_path() {
  printf '%s\n' "$cache_file"
}

# Names only, derived from the dotenv export rather than from `infisical secrets`.
#
# The table parser this replaces silently returned NOTHING. It matched rows
# beginning with an ASCII `|`, but the CLI draws its table with U+2502 `│` — so
# every row failed to match and `--list` printed an empty list with exit 0, which
# reads as "this project has no secrets" rather than as a parse failure. It is the
# worst shape of bug for this command: --list exists to answer "does the name I
# expect exist here", and it was answering no to everything.
#
# Parsing a human-facing table was the mistake, not the character: it is decoration
# the CLI is free to restyle, and this one already changed once. dotenv is the
# machine-readable output and is what --cache consumes, so --list now describes
# exactly the set that will actually reach a consumer.
#
# The cut is what keeps the contract: everything from the first `=` onward is
# dropped, so a value cannot reach stdout even if one contains a newline.
cmd_list() {
  cmd_dotenv | sed -nE 's/^([A-Za-z_][A-Za-z0-9_]*)=.*/\1/p' | sort
}

cmd_check() {
  require_setup
  printf '  domain:  %s\n' "$domain"
  printf '  project: %s\n' "$project"
  if infisical_run secrets --silent --domain="$domain" --projectId="$project" --env="$infisical_env" > /dev/null; then
    echo "  ✓ fetch works"
  else
    rc=$?
    [ "$rc" -eq 124 ] && die "timed out after ${timeout_s}s — infisical unreachable"
    die "cannot fetch (exit $rc) — try: infisical login"
  fi
}

case "${1:---check}" in
  --get) cmd_get "${2:-}" ;;
  --dotenv) cmd_dotenv ;;
  --run)
    shift
    [ "${1:-}" = "--" ] && shift
    cmd_run "$@"
    ;;
  --cache) cmd_cache ;;
  --cache-path) cmd_cache_path ;;
  --list) cmd_list ;;
  --check) cmd_check ;;
  -h | --help) sed -n '2,8p' "$0" ;;
  *) die "unknown option: $1 (try --help)" ;;
esac

#!/usr/bin/env bash
# Resolve the remote's default branch.
#
# Extracted from `wm` so the wrapper and the git-spice post-checkout hook cannot
# drift: both need "what is trunk on the remote", and they had better agree.
#
# Usage:
#   git-default-branch              -> origin/master   (remote-tracking ref)
#   git-default-branch --branch     -> master          (bare branch name)
#   git-default-branch --local      -> no network calls (see below)
#
# Prints nothing and exits 1 when there is no remote default to resolve — callers
# decide whether that is fatal.
#
# --local skips `git remote set-head origin -a`, which contacts the remote. Use it
# anywhere latency or offline behaviour matters, git hooks especially. Without a
# cached origin/HEAD, --local falls back to whichever of origin/main or
# origin/master exists locally.

set -uo pipefail

bare=0
local_only=0
for arg in "$@"; do
  case "$arg" in
    --branch) bare=1 ;;
    --local) local_only=1 ;;
    *)
      echo "[git-default-branch] unknown option: $arg" >&2
      exit 2
      ;;
  esac
done

git rev-parse --git-dir > /dev/null 2>&1 || exit 1

# Prefer what origin actually reports.
ref=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2> /dev/null || true)

# origin/HEAD is missing on clones made with --single-branch. Refreshing it needs
# the network, so only outside --local.
if [ -z "$ref" ] && [ "$local_only" -eq 0 ]; then
  git remote set-head origin -a > /dev/null 2>&1 || true
  ref=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2> /dev/null || true)
fi

# No advertised HEAD: fall back to conventional names that exist locally.
if [ -z "$ref" ]; then
  for candidate in origin/main origin/master; do
    if git rev-parse --verify --quiet "$candidate" > /dev/null 2>&1; then
      ref="$candidate"
      break
    fi
  done
fi

[ -n "$ref" ] || exit 1

if [ "$bare" -eq 1 ]; then
  echo "${ref#origin/}"
else
  echo "$ref"
fi

# Machine-local values. Copy to ~/.config/dotfiles/local.env and fill in.
#
#   install -m 600 -D commands/.local/share/dotfiles/local.example.env \
#     ~/.config/dotfiles/local.env
#
# Rules:
#   - plain KEY=VALUE, NO quotes and NO shell expansion. systemd's environment.d
#     reads this same file verbatim (symlink it, see below), and it does not
#     support either.
#   - no credentials: secrets are fetched at point of use by dotfiles-secrets.
#   - never commit it. `*.local`, `local.env` and `[0-9][0-9]-local*` are reserved
#     in .gitignore and .stow-local-ignore, and scripts/no-local-values.sh fails a
#     commit whose content contains any value from this file.
#
# Who reads it: the tracked `05-local-env` drop-in in each shell
# (fish conf.d, ~/.config/bashrc, ~/.config/zshrc, nushell local-env.nu).
#
# For anything launched OUTSIDE a shell — nvim from a desktop entry, systemd user
# services, the Wayland session — also symlink it once per machine:
#
#   ln -s ~/.config/dotfiles/local.env ~/.config/environment.d/50-local.conf
#
# nvim reads OLLAMA_HOST through vim.env, i.e. the environment of whatever
# launched it, so without that symlink it is unset outside a shell. Its API key is
# NOT read that way — nvim fetches it at point of use via dotfiles-secrets.
#
# Check what is missing:  dotfiles-local-env --check
# Manifest of consumers:  commands/.local/share/dotfiles/required-env

# --- git / forge -------------------------------------------------------------
DOTFILES_GITLAB_HOST=gitlab.example.com

# --- NAS (commands/.local/bin/mount-library.sh (private repo)) ------------------------------
NAS_HOST=nas.example.lan
#NAS_MOUNT_ROOT=
#HOME_NET_PREFIXES=

# --- AI gateways (sync-litellm-models, nvim ai.lua) --------------------------
INFISICAL_DOMAIN=https://infisical.example.com
INFISICAL_PROJECT=00000000-0000-0000-0000-000000000000

# The endpoint every AI consumer uses on THIS host. Loopback is the safe default
# and is what a machine running its own inference server wants; a remote value
# is only honoured when DOTFILES_PROFILE=personal. See nvim plugins/ai.lua.
AI_GATEWAY=http://127.0.0.1:11434

# Kill switch. Set to "off" to disable every AI integration regardless of the
# gateway or the profile. Anything else, including unset, means "follow the
# gateway rule above".
#DOTFILES_AI=off

# LiteLLM specifically — the homelab gateway that sync-litellm-models writes to.
# ai.lua reads it only as a fallback when AI_GATEWAY is unset.
LITELLM_GATEWAY=https://litellm.example.com
LEMONADE_URL=http://lemonade.example.lan:13305
OLLAMA_URL=http://ollama.example.lan:11434
# BARE HOST, NO PORT. gen.nvim formats "http://%s:%s" and supplies 11434 itself,
# so a port here produces "http://host:11434:11434". Ollama's own server reads
# the same variable as a bind address and defaults the port, so the bare form is
# the only value that is correct for both readers.
OLLAMA_HOST=ollama.example.lan

# --- misc --------------------------------------------------------------------
HERMES_TUI_GATEWAY_URL=http://localhost:8642
#VOL_SCREENSHOT_ARCHIVE=
#DOTFILES_SCREENSHOT_ARCHIVE=

# --- model naming (sync-litellm-models) --------------------------------------
# "<host>.<runner>" so two runners on one box stay distinct. Empty = bare runner
# name, which is safe but loses the host qualifier.
DOTFILES_LEMONADE_PREFIX=examplehost.lemonade
DOTFILES_OLLAMA_PREFIX=examplehost.ollama

# --- profile ------------------------------------------------------------------
# "personal" or "work". Unset means WORK: local AI stays off. Fail-safe on
# purpose — the failure mode is a work device reaching homelab infrastructure.
DOTFILES_PROFILE=work

# --- shared model weights -----------------------------------------------------
# One store, group-readable, shared by llama.cpp / llama-swap / the gfx1151
# toolbox. Deliberately NOT under /home: a systemd unit with ProtectHome=yes
# sees /home as an empty tmpfs, so files there are invisible to it whatever
# their ownership.
HF_HOME=/srv/models/hf
HF_HUB_CACHE=/srv/models/hf/hub
DOTFILES_LLAMASWAP_PREFIX=examplehost.llamaswap
LLAMASWAP_URL=http://localhost:8090

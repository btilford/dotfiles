# Machine-local values. Copy to ~/.config/dotfiles/local.env and fill in.
#
#   install -m 600 -D commands/.local/share/dotfiles/local.env.example \
#     ~/.config/dotfiles/local.env
#
# Rules:
#   - plain KEY=VALUE, NO quotes and NO shell expansion. systemd's environment.d
#     reads this same file verbatim (symlink it, see below), and it does not
#     support either.
#   - chmod 600: NEOVIM_API_KEY is a real credential.
#   - never commit it. `*.local`, `local.env` and `[0-9][0-9]-local*` are reserved
#     in .gitignore and .stow-local-ignore, and scripts/no-local-values.sh fails a
#     commit whose content contains any value from this file.
#
# Who reads it: the tracked `05-local-env` drop-in in each shell
# (fish conf.d, ~/.config/bashrc, ~/.config/zshrc, nushell local-env.nu).
#
# For anything launched OUTSIDE a shell — nvim from a desktop entry, systemd user
# services, the Wayland session — also symlink it once per machine:
#
#   ln -s ~/.config/dotfiles/local.env ~/.config/environment.d/50-local.conf
#
# nvim reads OLLAMA_HOST and NEOVIM_API_KEY through vim.env, i.e. the environment
# of whatever launched it, so without that symlink they are unset outside a shell.
#
# Check what is missing:  dotfiles-local-env --check
# Manifest of consumers:  commands/.local/share/dotfiles/required-env

# --- git / forge -------------------------------------------------------------
DOTFILES_GITLAB_HOST=gitlab.example.com

# --- NAS (commands/.local/bin/mount-library.sh) ------------------------------
NAS_HOST=nas.example.lan
NAS_MOUNT_ROOT=
HOME_NET_PREFIXES=

# --- AI gateways (sync-litellm-models, nvim ai.lua) --------------------------
INFISICAL_DOMAIN=https://infisical.example.com
INFISICAL_PROJECT=00000000-0000-0000-0000-000000000000
LITELLM_GATEWAY=https://litellm.example.com
LEMONADE_URL=http://lemonade.example.lan:13305
OLLAMA_URL=http://ollama.example.lan:11434
OLLAMA_HOST=ollama.example.lan:11434
NEOVIM_API_KEY=replace-me

# --- misc --------------------------------------------------------------------
HERMES_TUI_GATEWAY_URL=http://localhost:8642
VOL_SCREENSHOT_ARCHIVE=
DOTFILES_SCREENSHOT_ARCHIVE=

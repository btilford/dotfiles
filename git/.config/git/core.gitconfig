[core]
    editor = nano
    excludesfile = ~/.config/git/default.gitignore
    autocrlf = input
    commentchar = '#'

[init]
    templatedir = ~/.config/git/default-template

[credential]
  helper = store


[credential "https://gitlab.example.com"]
  helper =
  helper = !/usr/local/bin/glab auth git-credential

[credential "https://github.com"]
        helper =
        helper = !/usr/bin/gh auth git-credential

[protocol "persistent-https"]
	allow = always

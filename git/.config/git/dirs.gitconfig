
# Path specific git configs extending ~/.gitconfig
[includeIf "gitdir:~/dotfiles/"]
    path = ~/.config/git/profiles/default.gitconfig


[includeIf "gitdir:~/dotfiles/"]
    path = ~/.config/git/profiles/default.gitconfig
[includeIf "gitdir:~/.dotfiles/"]
    path = ~/.config/git/profiles/default.gitconfig
[includeIf "gitdir:~/nix-configs/"]
    path = ~/.config/git/profiles/default.gitconfig
[includeIf "gitdir:~/.config/"]
    path = ~/.config/git/profiles/default.gitconfig
[includeIf "gitdir:~/Documents/personal-notes/notes/"]
    path = ~/.config/git/profiles/default.gitconfig


[includeIf "gitdir:~/Projects/open/"]
    path = ~/.config/git/profiles/default.gitconfig
[includeIf "gitdir:~/Projects/personal/"]
    path = ~/.config/git/profiles/default.gitconfig

[includeIf "gitdir:~/Projects/public/"]
    path = ~/.config/git/profiles/default.gitconfig

[includeIf "gitdir:~/Projects/keyboard/"]
    path = ~/.config/git/profiles/default.gitconfig


[includeIf "gitdir:~/Projects/homelab/"]
    path = ~/.config/git/profiles/default.gitconfig
# Client/employer directories are named in ~/.gitconfig.local, not here — a
# directory name is itself an identifying detail. Pattern to copy there:
#
#   [includeIf "gitdir:~/Projects/<client>/"]
#       path = ~/.config/git/profiles/anon.gitconfig
#
# There is no catch-all includeIf, so a machine missing that block gets NO identity
# for those repos and commits fail outright.
[includeIf "gitdir:~/Projects/private/practice/"]
    path = ~/.config/git/profiles/default.gitconfig
[includeIf "gitdir:~/Projects/private/qmk/"]
    path = ~/.config/git/profiles/default.gitconfig




# Old layout
[includeIf "gitdir:~/work/"]
    path = ~/.config/git/profiles/default.gitconfig
[includeIf "gitdir:~/work/anon/"]
    path = ~/.config/git/profiles/anon.gitconfig

# Work identity is not in this repo — it names an employer, a work GitHub
# account and a ticket tracker. It lives in ~/.gitconfig.local instead, which is
# included last by .gitconfig. On a work machine, add there:
#
#   [includeIf "gitdir:~/Projects/<employer>/"]
#       path = ~/.gitconfig.work
#
# There is no catch-all includeIf in this file, so until that block exists,
# repos under that directory get NO user identity and commits will fail.


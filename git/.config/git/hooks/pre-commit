#!/usr/bin/env sh
# Block staged secrets with betterleaks, in every repo — not just the ones that
# opted into a hook manager.
#
# Reached via the shim that init.templateDir installs into .git/hooks. Note this
# hook is the opposite of the post-checkout one: it MUST be able to fail, since
# failing is the entire point. Only a missing betterleaks exits 0.
#
# Third surface for this gate, alongside `mise run lint:secrets` and
# .gitlab-ci.yml's lint:secrets job (see the Linting section of CLAUDE.md). It
# stays aligned by using the repo's own config when there is one, so each repo's
# allowlists apply here too, rather than carrying a copy of them. Scope differs
# on purpose: mise and CI scan the whole tree, this scans staged content.
#
# Escape hatches, when a repo has secret-shaped fixtures: `git commit --no-verify`,
# or an allowlist in that repo's .betterleaks.toml.
#
# betterleaks replaced gitleaks here on 2026-08-24 — same author, drop-in on
# config and on the `gitleaks:allow` pragma, so a repo still carrying a
# .gitleaks.toml is picked up unchanged (betterleaks' own config precedence
# tries .betterleaks.toml first, then .gitleaks.toml). No gitleaks fallback: a
# gate that quietly runs a different scanner than the one the config was written
# for is worse than one that is plainly absent.
#
# `betterleaks git --staged`: scans the staged content only, which is what this
# hook is for. Output is deliberately NOT redacted — this runs in the author's
# own terminal, on content they just wrote, and seeing the value is how you know
# which line to fix. CI redacts instead, because CI logs are published.

command -v betterleaks > /dev/null 2>&1 || exit 0

root=$(git rev-parse --show-toplevel 2> /dev/null) || exit 0

# A repo whose hk.pkl runs betterleaks already gates staged content through hk
# (registered globally in ~/.config/git/hk.gitconfig). Config-based hooks and
# .git/hooks/* BOTH fire, so without this the staged content would be scanned
# twice on every commit in every repo that adopts hk.
#
# The grep is the point: `[ -f hk.pkl ]` alone would silently drop the gate the
# moment a repo adopted hk WITHOUT a betterleaks step. Deferring only to an
# hk.pkl that names the scanner keeps "hk owns this" and "nobody owns this"
# distinguishable.
if [ -f "$root/hk.pkl" ] && grep -q betterleaks "$root/hk.pkl"; then
  exit 0
fi

for cfg in .betterleaks.toml .gitleaks.toml; do
  if [ -f "$root/$cfg" ]; then
    exec betterleaks git --staged -c "$root/$cfg" --no-banner
  fi
done

exec betterleaks git --staged --no-banner

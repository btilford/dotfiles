#!/usr/bin/env bash
# Retrofit the git template hooks into repos that already exist.
#
# init.templateDir only fires at `git init` / `git clone`, so repos cloned before
# it was enabled have no hooks. `git init --template=...` installs the missing ones
# without touching anything else — verified: it does NOT overwrite an existing
# hook, it skips it silently. That silent skip is why this script exists.
#
# Usage:
#   git-spice-hook-install                 # current repo
#   git-spice-hook-install ~/src/a ~/src/b # named repos
#
# Idempotent. Reports what it did per repo, and never skips silently.

set -uo pipefail

template="${GIT_TEMPLATE_DEST:-$HOME/.local/share/git-template}"
marker='# git-spice-hook-chain'
chain_suffix='.chained'

if [ ! -d "$template" ]; then
  echo "[hook-install] template not found: $template" >&2
  echo "[hook-install] run git-template-sync first" >&2
  exit 1
fi

# write_chain_wrapper <hook path> <chained path> <hook name>
#
# The path to the incumbent must be ABSOLUTE. A relative one (e.g. ./.git/hooks/…)
# resolves only in a main checkout: in a linked worktree ./.git is a file, so the
# chained hook would silently never run.
write_chain_wrapper() {
  local hook="$1" chained="$2" name="$3"

  cat > "$hook" << EOF
#!/usr/bin/env sh
$marker — installed by git-spice-hook-install.
# Runs the stowed hook first (fast, always exits 0), then the hook that was here
# before, which is preserved verbatim as $(basename "$chained").
#
# If a tool reinstalls its own $name it will clobber this wrapper and orphan the
# $chain_suffix file. Re-run git-spice-hook-install to restore the chain.

if [ -x "\$HOME/.config/git/hooks/$name" ]; then
    "\$HOME/.config/git/hooks/$name" "\$@"
fi

if [ -x "$chained" ]; then
    exec "$chained" "\$@"
fi
EOF
  chmod +x "$hook"
}

install_one() {
  local repo="$1"
  local hooks name existing

  # --path-format=absolute matters: the bare form returns ".git" in a main
  # checkout, and a relative path baked into the chain wrapper below breaks in a
  # LINKED WORKTREE, where ./.git is a file rather than a directory — the chained
  # hook would then silently never run.
  if ! hooks=$(git -C "$repo" rev-parse --path-format=absolute --git-common-dir 2> /dev/null); then
    echo "  ✗ $repo — not a git repository"
    return 1
  fi
  hooks="$hooks/hooks"

  # A repo-level core.hooksPath wins over everything here (husky sets one), so
  # our hooks would never run. Say so rather than pretending to install.
  if existing=$(git -C "$repo" config --local --get core.hooksPath 2> /dev/null); then
    echo "  ⚠ $repo — repo sets core.hooksPath=$existing; git ignores .git/hooks here. Skipped."
    return 0
  fi

  # Record what was there first, so the report can tell "installed just now"
  # apart from "was already ours".
  local preexisting=""
  for name in post-checkout pre-commit; do
    [ -f "$hooks/$name" ] && preexisting="$preexisting $name"
  done

  git -C "$repo" init --quiet --template="$template" . > /dev/null 2>&1

  for name in post-checkout pre-commit; do
    local hook="$hooks/$name"
    local chained="$hook$chain_suffix"

    # Ours already, whether shim or chain wrapper.
    if [ -f "$hook" ] && grep -q 'config/git/hooks' "$hook" 2> /dev/null; then
      # One exception: repair a chain wrapper that references the incumbent
      # by a relative path (written by the first version of this script).
      # Those break in linked worktrees, so rewrite rather than skip.
      if [ -e "$chained" ] && ! grep -q "\"$chained\"" "$hook" 2> /dev/null; then
        write_chain_wrapper "$hook" "$chained" "$name"
        echo "  ~ $repo — $name chain wrapper repaired (absolute path to $(basename "$chained"))"
        continue
      fi
      case " $preexisting " in
        *" $name "*) echo "  = $repo — $name already ours" ;;
        *) echo "  + $repo — $name installed" ;;
      esac
      continue
    fi

    if [ ! -f "$hook" ]; then
      echo "  ✗ $repo — $name missing after init (template incomplete?)"
      continue
    fi

    # Someone else owns this hook.
    if [ "$name" = pre-commit ]; then
      # Do not chain pre-commit. hk and the pre-commit framework already run
      # a secret scan in repos configured for it (this repo does, via the
      # betterleaks step in hk.pkl), and chaining would run it twice.
      echo "  ⚠ $repo — pre-commit belongs to another tool; left alone (no double scan)"
      continue
    fi

    # Chain post-checkout by moving theirs aside, rather than appending to it:
    # hooks commonly use guard-clause `exit 0`s (graphify's does), which would
    # make appended code unreachable on exactly the paths that matter.
    if [ -e "$chained" ]; then
      echo "  ✗ $repo — $chained already exists; resolve by hand"
      continue
    fi

    mv "$hook" "$chained"
    write_chain_wrapper "$hook" "$chained" "$name"
    echo "  + $repo — $name chained (previous hook kept as $(basename "$chained"))"
  done
}

if [ "$#" -eq 0 ]; then
  set -- .
fi

status=0
for repo in "$@"; do
  install_one "$repo" || status=1
done
exit "$status"

" .ideavimrc is a configuration file for IdeaVim plugin. It uses
"   the same commands as the original .vimrc configuration.
" You can find a list of commands here: https://jb.gg/h38q75
" Find more examples here: https://jb.gg/share-ideavimrc
"
" Keys follow the nvim config in this package: same leader groups, LSP gr*
" maps, mini.surround s* maps and <C-hjkl> split moves. Needs IdeaVim >= 2.48.

" Source your .vimrc
source ~/.vimrc

" Plugins read the leader when they register their maps, so set it first.
let mapleader = " "

"" -- Suggested options --
" Don't use Ex mode, use Q for formatting.
map Q gq
set ideajoin
set ideamarks
set clipboard^=ideaput
set colorcolumn=1,+0
set list

set ideacopypreprocess
set idearefactormode=select
set ideastatusicon=enabled
set ideavimsupport=dialog,singleline
set ideawrite=file
"set ideatrackactionids

" Scrolling with the mouse moves the caret, and each split keeps its own
" jump list, as in nvim.
set ideascrollcursor
set ideawindowjumps
" Vim in the AI Assistant chat prompt (Claude Agent included). It opens in
" Insert mode, so <Enter> still sends.
set ideaeditor+=chat

" --- Enable IdeaVim plugins https://jb.gg/ideavim-plugins
Plug 'machakann/vim-highlightedyank'
Plug 'tpope/vim-commentary'
Plug 'tpope/vim-surround'
" targets.vim stands in for mini.ai: pairs, quotes, args, tags, next/last.
Plug 'wellle/targets.vim'
Plug 'michaeljsmith/vim-indent-object'
" Sub-word motions on comma: ,w ,b ,e ,ge and ci,w.
let g:camelcasemotion_key = ','
Plug 'bkad/CamelCaseMotion'
Plug 'vim-scripts/ReplaceWithRegister'
Plug 'bronson/vim-visual-star-search'
Plug 'preservim/nerdtree'
packadd matchit
set peekaboo
set which-key
set timeoutlen=5000
let g:WhichKey_ShowVimActions = "true"
" Tool windows, trees and tables get vim keys.
set VimEverywhere

" clever-f stands in for flash.nvim's char mode: f/F/t/T repeat with the
" same key. It replaces quickscope, which highlighted the same targets.
let g:clever_f_smart_case = 1
Plug 'rhysd/clever-f.vim'

" EasyMotion stands in for flash.nvim jumps. Its default <leader><leader>
" maps are off, so that key stays free for the recent-files picker.
let g:EasyMotion_do_mapping = 0
Plug 'easymotion/vim-easymotion'

" visual-multi replaces vim-multiple-cursors; both claim <C-n>. Arrow keys
" add cursors as multicursor.nvim does; <C-arrows> stay window moves.
let g:VM_maps = {}
let g:VM_maps['Add Cursor Down'] = '<Down>'
let g:VM_maps['Add Cursor Up'] = '<Up>'
Plug 'mg979/vim-visual-multi'
nmap <leader>n <Plug>(VM-Find-Under)
xmap <leader>n <Plug>(VM-Find-Subword-Under)

" ----------------------------------------------
" Which-key groups (mirror nvim's which-key spec)
" ----------------------------------------------
let g:WhichKeyDesc_search = "<leader>s Search"
let g:WhichKeyDesc_ai = "<leader>a AI"
let g:WhichKeyDesc_code = "<leader>c Code"
let g:WhichKeyDesc_run = "<leader>r Run"
let g:WhichKeyDesc_debug = "<leader>d Debug"
let g:WhichKeyDesc_buffer = "<leader>b Buffer"
let g:WhichKeyDesc_diagnostics = "<leader>x Diagnostics"
let g:WhichKeyDesc_git = "<leader>g Git"
let g:WhichKeyDesc_flash = "<leader>F Flash"
let g:WhichKeyDesc_undo = "<leader>u Undo"

" ----------------------------------------------
" Basics (mappings.lua)
" ----------------------------------------------
nnoremap ; :
inoremap jk <Esc>
" <C-a> selects all, so + and - do vim's increment and decrement.
map <C-a> <Action>($SelectAll)
nnoremap + <C-a>
nnoremap - <C-x>
nnoremap ,p "0p
xnoremap ,p "0p
imap <C-v> <Action>($Paste)
imap <C-p> <Action>($Paste)
imap <C-c> <Action>($Copy)
imap <C-y> <Action>($Copy)
map <leader>f <Action>(ReformatCode)

" mini.surround keys on top of vim-surround's ys/ds/cs.
nmap sa <Plug>YSurround
xmap sa <Plug>VSurround
nmap sd <Plug>DSurround
nmap sr <Plug>CSurround

" ----------------------------------------------
" Search (telescope)
" ----------------------------------------------
nmap <leader>sf <Action>(GotoFile)
nmap <leader>sg <Action>(FindInPath)
nmap <leader>sw <Action>(FindInPath)
nmap <leader>ss <Action>(GotoAction)
nmap <leader>sc <Action>(GotoClass)
nmap <leader>so <Action>(GotoClass)
nmap <leader>sa <Action>(SearchEverywhere)
nmap <leader>sd <Action>(ActivateProblemsViewToolWindow)
nmap <leader>sR <Action>(ReplaceInPath)
nmap <leader>sW <Action>($SearchWeb)
nmap <leader><leader> <Action>(RecentFiles)
nmap <leader>/ <Action>(Find)

" ----------------------------------------------
" Editor Nav
" ----------------------------------------------
nmap <S-Tab> <Action>(PreviousTab)
nmap <Tab> <Action>(NextTab)
nmap ]b <Action>(NextTab)
nmap [b <Action>(PreviousTab)
nmap <leader>bn <Action>(NextTab)
nmap <leader>bp <Action>(PreviousTab)
nmap <leader>bb <C-^>
map <leader>e <Action>(ActivateProjectToolWindow)
" Split moves use IDE actions, because <C-w> is not usable on this keymap.
" <C-h> and <C-k> only reach vim once their handler is set to Vim (see below).
map <C-h> <Action>(PrevSplitter)
map <C-k> <Action>(PrevSplitter)
map <C-j> <Action>(NextSplitter)
map <C-l> <Action>(NextSplitter)
map <C-Left> <Action>(PrevSplitter)
map <C-Up> <Action>(PrevSplitter)
map <C-Down> <Action>(NextSplitter)
map <C-Right> <Action>(NextSplitter)

" ----------------------------------------------
" Flash
" ----------------------------------------------
map <leader>Fj <Plug>(easymotion-s)
nmap <leader>Ft <Action>(EditorSelectWord)
xmap <leader>Ft <Action>(EditorSelectWord)

" ----------------------------------------------
" LSP (nvim 0.11 gr* defaults + lspconfig.lua)
" ----------------------------------------------
nmap gd <Action>(GotoDeclaration)
nmap grd <Action>(GotoDeclaration)
nmap grn <Action>(RenameElement)
nmap gra <Action>(ShowIntentionActions)
xmap gra <Action>(ShowIntentionActions)
nmap grr <Action>(ShowUsages)
nmap gri <Action>(GotoImplementation)
nmap grt <Action>(GotoTypeDeclaration)
nmap gO <Action>(FileStructurePopup)
nmap gW <Action>(GotoSymbol)
nmap ]d <Action>(GotoNextError)
nmap [d <Action>(GotoPreviousError)
nmap ]q <Action>(NextOccurence)
nmap [q <Action>(PreviousOccurence)
nmap gf <Action>(GoToLinkTarget)

" ----------------------------------------------
" Refactoring / Code
" ----------------------------------------------
nmap <leader>ca <Action>(ShowIntentionActions)
xmap <leader>ca <Action>(ShowIntentionActions)
map <leader>crn <Action>(RenameElement)
map <leader>crm <Action>(RefactoringMenu)
map <leader>ld <Action>(EditorDuplicateLines)

" ----------------------------------------------
" Diagnostics / Git / Undo
" ----------------------------------------------
nmap <leader>q <Action>(ActivateProblemsViewToolWindow)
nmap <leader>xx <Action>(ActivateProblemsViewToolWindow)
nmap <leader>gl <Action>(ActivateVersionControlToolWindow)
nmap <leader>ut <Action>(LocalHistory.ShowHistory)

" ----------------------------------------------
" Run / Debug
" ----------------------------------------------
" Kept off the gr* prefix, which nvim gives to LSP.
nmap <leader>rc <Action>(ContextRun)
nmap <leader>rr <Action>(Rerun)
nmap <leader>rf <Action>(RerunFailedTests)
nmap <leader>rt <Action>(RerunTests)
nmap <leader>rv <Action>(RunCoverage)
nmap <leader>rg <Action>(Gradle.ExecuteTask)
nmap <leader>re <Action>(Console.Jdbc.Execute)
imap <C-Enter> <Action>(Console.Jdbc.Execute)
nmap <leader>dd <Action>(ContextDebug)
nmap <leader>db <Action>(ToggleLineBreakpoint)

" ----------------------------------------------
" Claude Code (AI)
" ----------------------------------------------
" Same keys as opencode.nvim: ga adds the selection to the agent's context,
" <C-.> opens the agent. The <leader>a pair is for which-key discovery.
nmap ga <Action>(com.anthropic.code.plugin.actions.SendToClaudeAction)
xmap ga <Action>(com.anthropic.code.plugin.actions.SendToClaudeAction)
nmap <C-.> <Action>(com.anthropic.code.plugin.actions.OpenClaudeInTerminalAction)
nmap <leader>ao <Action>(com.anthropic.code.plugin.actions.OpenClaudeInTerminalAction)
nmap <leader>as <Action>(com.anthropic.code.plugin.actions.SendToClaudeAction)
xmap <leader>as <Action>(com.anthropic.code.plugin.actions.SendToClaudeAction)

" ----------------------------------------------
" Continue (AI)
" ----------------------------------------------
" The plugin binds chat and edit to ctrl/meta I and J, and BOTH are unusable
" here: meta does not survive this machine's key remapping, and ctrl I / ctrl J
" are assigned to vim in IdeaVim's conflict table. Leader sequences avoid the
" contest — they are plain keys, so nothing else claims them.
"
" Continue's editor tooltip advertises "chat alt+j | edit alt+i". That label is
" wrong: no action is bound to alt J or alt I anywhere in the plugin.
nmap <leader>ac <Action>(continue.focusContinueInput)
vmap <leader>ac <Action>(continue.focusContinueInput)
nmap <leader>ae <Action>(continue.inlineEdit)
vmap <leader>ae <Action>(continue.inlineEdit)
nmap <leader>aa <Action>(continue.acceptDiff)
nmap <leader>ar <Action>(continue.rejectDiff)

" ----------------------------------------------
" Shortcut handlers
" ----------------------------------------------
" NOT SET HERE. `sethandler` parses without error and has no effect — tested
" 2026-09-04 with a full IDE restart, and the shortcut never reaches IdeaVim's
" conflict table. Set the handler in Settings -> Editor -> Vim instead, which
" writes vim_settings.xml and works.
"
" This keymap's parent is NetBeans 6.5, which takes these from the mappings
" above: <C-y> $Redo, <C-h> Replace, <C-k> HippieBackwardCompletion,
" <C-n> NewElement, <Tab>/<S-Tab> indent and unindent.
"
" Do NOT give <Tab> to vim there. That table has one owner per shortcut with no
" mode split, so vim would take insert-mode <Tab> too — which is the key that
" accepts an inline completion.

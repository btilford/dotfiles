# Hand org.freedesktop.secrets to ksecretd (kwallet), not gnome-keyring.
#
# kwallet ships NO activation file for this name — only org.kde.kwalletd6 and
# org.kde.secretservicecompat. gnome-keyring ships the only one, at
# /usr/share/dbus-1/services/org.freedesktop.secrets.service. XDG_DATA_HOME
# precedes XDG_DATA_DIRS, so this file wins while gnome-keyring is installed and
# is the only activation path once it is removed.
#
# The absolute Exec path is required by the D-Bus spec: activation does no PATH
# lookup. gnome-keyring's own file has the same shape.
[D-BUS Service]
Name=org.freedesktop.secrets
Exec=/usr/bin/ksecretd

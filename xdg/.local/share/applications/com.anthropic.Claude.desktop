[Desktop Entry]
# Copy of /usr/share/applications/com.anthropic.Claude.desktop, shadowed by
# XDG_DATA_HOME precedence. The ONLY change is --password-store=kwallet6 on all
# three Exec lines. Claude Desktop reads no flags file and no environment
# variable for this, so the switch has to reach it through the entry that
# launches it. See ../../../README.md for why the switch is required here.
Name=Claude
Comment=Desktop application for Claude.ai
GenericName=AI Assistant
Keywords=AI;Chat;Assistant;Claude;Code;LLM;
Exec=claude-desktop --password-store=kwallet6 %U
Icon=claude-desktop
Type=Application
StartupNotify=true
# Matches the Wayland app_id / X11 WM_CLASS Chromium derives from
# package.json desktopName, so docks group windows under this entry.
StartupWMClass=com.anthropic.Claude
# second-instance just focuses mainWindow; suppress GNOME's default "New Window" item
SingleMainWindow=true
Categories=Utility;Development;
MimeType=x-scheme-handler/claude;
Actions=NewChat;NewCode;

[Desktop Action NewChat]
Name=New chat
Exec=claude-desktop --password-store=kwallet6 claude://claude.ai/new

[Desktop Action NewCode]
Name=New Claude Code session
Exec=claude-desktop --password-store=kwallet6 claude://code/new

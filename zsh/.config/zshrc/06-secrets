# Secrets: read the session cache into this shell, and define the helpers.
#
# The old rule here was "runs nothing" — no secret ever reached the environment
# automatically. That was reversed deliberately (see the header of
# `dotfiles-secrets` for the full reasoning): consumers that can only take an
# environment variable — clipborg expands ${ENV} at config load and hard-errors
# on an unset one; opencode, aider and nvim are the same shape — do not work in a
# plain terminal otherwise, and wrapping every entry point was not practical.
#
# What has NOT changed is the reason that rule existed: **no shell may call
# infisical at startup.** That is a network round trip on every new terminal and
# it hangs the shell when the gateway is unreachable or the wallet is locked.
#
# So the fetch moved off the shell's path entirely rather than into it. One
# systemd user unit (dotfiles-secrets.service) fetches ONCE at login and writes
# $XDG_RUNTIME_DIR/dotfiles/secrets.env (tmpfs, 0600, gone at logout). The block
# below is a plain read of that small local file: no network, no infisical, no
# keyring, nothing that can block or prompt. A terminal opens at the same speed
# whether the gateway is up, down, or was never configured on this machine.
#
# The honest cost, stated plainly: secrets are now in the environment of every
# shell and everything it spawns, not just a command you named.
#
#   secrets-run opencode     secrets live in that process only, and die with it
#   secrets-load             re-read the cache into THIS shell
#   secrets-refresh          re-fetch (after rotating a key), then reload
#
# secrets-run remains preferable for anything that does not need the variable
# ambiently — it is the narrower exposure, and it still works.

if [ -r "${XDG_RUNTIME_DIR:-/nonexistent}/dotfiles/secrets.env" ]; then
  # `set -a` exports what the source defines. The cache is infisical's own dotenv
  # format, already quoted, which is what the shell expects.
  set -a
  # shellcheck disable=SC1091  # runtime-generated, never present at lint time
  . "$XDG_RUNTIME_DIR/dotfiles/secrets.env"
  set +a
fi

secrets-run() {
  if [ "$#" -eq 0 ]; then
    echo "usage: secrets-run COMMAND [ARGS...]" >&2
    return 2
  fi
  dotfiles-secrets --run -- "$@"
}

secrets-load() {
  local cache="${XDG_RUNTIME_DIR:-/nonexistent}/dotfiles/secrets.env"
  local dotenv

  # Prefer the cache and fall back to a live fetch. Reversing that order would
  # put a network call on the common path for no gain — the cache is what the
  # login unit just wrote, and `secrets-refresh` is how you deliberately renew it.
  if [ -r "$cache" ]; then
    dotenv=$(cat "$cache")
  else
    dotenv=$(dotfiles-secrets --dotenv) || return 1
  fi

  set -a
  eval "$dotenv"
  set +a
  echo "[secrets] loaded $(printf '%s\n' "$dotenv" | grep -c '=') secret(s) into this shell" >&2
}

secrets-refresh() {
  systemctl --user restart dotfiles-secrets.service || return 1
  secrets-load
}

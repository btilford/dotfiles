# Secrets helpers. DEFINES functions — runs nothing.
#
# Nothing here touches infisical at shell startup, deliberately: a network call in
# an rc file hangs every new terminal when the daemon is unreachable or the
# keyring is locked. Secrets arrive only when you ask for them.
#
#   secrets-run opencode     secrets live in that process only, and die with it
#   secrets-load             export into THIS shell, for tools that need env vars
#
# Prefer secrets-run. secrets-load leaves the values in the shell and in every
# child it later spawns, which is occasionally what you want and always worth
# choosing on purpose.

secrets-run() {
  if [ "$#" -eq 0 ]; then
    echo "usage: secrets-run COMMAND [ARGS...]" >&2
    return 2
  fi
  dotfiles-secrets --run -- "$@"
}

secrets-load() {
  local dotenv
  dotenv=$(dotfiles-secrets --dotenv) || return 1

  # `set -a` exports whatever the eval defines. The values are quoted by
  # infisical's dotenv format, which is exactly what eval expects.
  set -a
  eval "$dotenv"
  set +a
  echo "[secrets] loaded $(printf '%s\n' "$dotenv" | grep -c '=') secret(s) into this shell" >&2
}

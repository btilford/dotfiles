# Interactive shells only
[[ $- == *i* ]] || return

HISTCONTROL=erasedups
HISTFILESIZE=200000
HISTIGNORE='ls:exit'
HISTSIZE=10000

shopt -s histappend
shopt -s checkwinsize
shopt -s extglob
shopt -s globstar
shopt -s checkjobs

alias k=kubectl

command -v direnv    >/dev/null 2>&1 && eval "$(direnv hook bash)"
command -v zoxide    >/dev/null 2>&1 && eval "$(zoxide init bash --cmd cd)"
command -v fzf       >/dev/null 2>&1 && eval "$(fzf --bash)"
command -v carapace  >/dev/null 2>&1 && source <(carapace _carapace bash)

if command -v starship >/dev/null 2>&1; then
    if [[ $TERM != "dumb" ]]; then
        eval "$(starship init bash)"
    fi
fi

if command -v asdf >/dev/null 2>&1; then
    . <(asdf completion bash)
    export ASDF_DATA_DIR="${HOME}/.asdf"
    PATH="${ASDF_DATA_DIR}/shims:${PATH}"
fi

if command -v obsidian-cli >/dev/null 2>&1; then
    source <(obsidian-cli completion bash)
fi

if command -v wt >/dev/null 2>&1; then
    eval "$(command wt config shell init bash)"
fi

if command -v workmux >/dev/null 2>&1; then
    source <(workmux completions bash)
fi

# Yazi wrapper: cd into last directory on exit
function y() {
    local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
    yazi "$@" --cwd-file="$tmp"
    if cwd="$(command cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
        builtin cd -- "$cwd"
    fi
    rm -f -- "$tmp"
}

export SUDO_EDITOR="nvim"
_sudoedit() { sudo -e "$1"; }
alias sudoedit='_sudoedit'

export GOPATH="$HOME/go"
export M2_HOME="$HOME/.m2"
export ENCORE_INSTALL="${HOME}/.encore"
PATH="${PATH}:${HOME}/.local/bin:${GOPATH}/bin:${ENCORE_INSTALL}/bin"

#THIS MUST BE AT THE END OF THE FILE FOR SDKMAN TO WORK!!!
export SDKMAN_DIR="$HOME/.sdkman"
[[ -s "$HOME/.sdkman/bin/sdkman-init.sh" ]] && source "$HOME/.sdkman/bin/sdkman-init.sh"

# VTE prompt integration (Linux GNOME terminals)
if [[ -f /etc/profile.d/vte.sh ]]; then
    . /etc/profile.d/vte.sh
    if [[ $(type -t __vte_prompt_command) == function ]]; then
        __HM_PROMPT_COMMAND="${PROMPT_COMMAND:+${PROMPT_COMMAND%;};}__hm_vte_prompt_command"
        __hm_vte_prompt_command() {
            local old_exit_status=$?
            __vte_prompt_command
            return $old_exit_status
        }
        PROMPT_COMMAND="$__HM_PROMPT_COMMAND"
        unset __HM_PROMPT_COMMAND
    fi
fi

# pkgfile command-not-found (Arch Linux)
[[ -f /usr/share/doc/pkgfile/command-not-found.bash ]] && \
    . /usr/share/doc/pkgfile/command-not-found.bash

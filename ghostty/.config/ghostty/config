custom-shader = shaders/cursor_warp.glsl
#custom-shader = shaders/ripple_rectangle_cursor.glsl
font-size = 20
font-family = "JetBrains Mono"
background-opacity = 0.75
cursor-color = #aa8844
cursor-text = #111111
#cursor-invert-fg-bg = true
cursor-style = block
#cursor-style = block_hollow
cursor-opacity = 0.7
cursor-click-to-move = true
#selection-invert-fg-bg
selection-background=#ffaa00
selection-foreground=#222222
mouse-hide-while-typing = true
mouse-shift-capture = true
clipboard-trim-trailing-spaces = true
clipboard-paste-protection = true
clipboard-paste-bracketed-safe = true
copy-on-select = true
shell-integration-features = cursor,sudo,title
desktop-notifications = true
app-notifications = clipboard-copy,no-config-reload

keybind = alt+r=reload_config

keybind = global:f12=toggle_quick_terminal

keybind = alt+l=goto_split:right
keybind = alt+h=goto_split:left
keybind = alt+k=goto_split:top
keybind = alt+j=goto_split:bottom
keybind = ctrl+enter=unbind

keybind = ctrl+shift+u=copy_url_to_clipboard

# MacOS hacks :(
keybind = ctrl+shift+v=paste_from_clipboard
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+c=text:\x03

# keybind = "ctrl+shift+j=write_scrollback_file:paste"
# keybind = "ctrl+alt+shift+j=write_scrollback_file:open"

#env = GHOSTTY_THEME=dark
#env = SNACKS_GHOSTTY=true
#
#
# Theme switching (optional): managed by your theme changer (symlink or generated file).
config-file = ?~/.config/ghostty/theme.conf

# Wallust (optional): wallust template should write Ghostty colors here; it will override theme colors.
config-file = ?~/.config/ghostty/wallust.conf

{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "io.github.brave/brave-search-mcp-server": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@brave/brave-search-mcp-server"
      ],
      "enabled": true,
      "environment": {
        "BRAVE_API_KEY": "***REMOVED***"
      }
    },
    "com.gitlab/mcp": {
      "type": "remote",
      "url": "https://gitlab.example.com/api/v4/mcp",
      "enabled": true
    }
  },
  "plugin": [
    ".opencode/plugins/graphify.js"
  ]
}
alternate-normal-background: #2A0E14;
alternate-normal-foreground: #DED9DA;
alternate-urgent-background: #2A0E14;
alternate-urgent-foreground: #DED9DA;

selected-active-background: #5D494D;
selected-active-foreground: #2A0E14;
selected-normal-background: #5D494D;
selected-normal-foreground: #2A0E14;

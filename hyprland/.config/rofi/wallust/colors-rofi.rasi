 /* wallust template - colors-rofi */

* {
active-background: #5D494D;
active-foreground: #DED9DA;
normal-background: #2A0E14;
normal-foreground: #DED9DA;
urgent-background: #5D494D;
urgent-foreground: #DED9DA;

alternate-active-background: #664B4E;

 /* wallust template - colors-rofi */

* {
active-background: #524548;
active-foreground: #D6D3D3;
normal-background: #1D0B0F;
normal-foreground: #D6D3D3;
urgent-background: #524548;
urgent-foreground: #D6D3D3;

alternate-active-background: #524548;
alternate-active-foreground: #D6D3D3;
alternate-normal-background: #1D0B0F;
alternate-normal-foreground: #D6D3D3;
alternate-urgent-background: #1D0B0F;
alternate-urgent-foreground: #D6D3D3;

selected-active-background: #524548;
selected-active-foreground: #1D0B0F;
selected-normal-background: #524548;
selected-normal-foreground: #1D0B0F;
selected-urgent-background: #524548;
selected-urgent-foreground: #1D0B0F;

background-color: rgba(29,11,15,0.3);
background: rgba(29,11,15,0.3);
foreground: #D6D3D3;
border-color: #524548;

color0: #A5A0A1;
color1: #9A6A5D;
color2: #905B4F;
color3: #4C4245;
color4: #4C4245;
color5: #4C4245;
color6: #4C4245;
color7: #4B261B;
color8: #743B2A;
color9: #B36C57;
color10: #AC6657;
color11: #524548;
color12: #524548;
color13: #524548;
color14: #524548;

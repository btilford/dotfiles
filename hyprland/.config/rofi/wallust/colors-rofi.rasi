 /* wallust template - colors-rofi */

* {
active-background: #826B6C;
active-foreground: #C7D7D6;
normal-background: #1D1E1F;
normal-foreground: #C7D7D6;
urgent-background: #CD4A3A;
urgent-foreground: #C7D7D6;

alternate-active-background: #4B1B19;
alternate-active-foreground: #C7D7D6;
alternate-normal-background: #1D1E1F;
alternate-normal-foreground: #C7D7D6;
alternate-urgent-background: #1D1E1F;
alternate-urgent-foreground: #C7D7D6;

selected-active-background: #826B6C;
selected-active-foreground: #1D1E1F;
selected-normal-background: #826B6C;
selected-normal-foreground: #1D1E1F;
selected-urgent-background: #4B1B19;
selected-urgent-foreground: #1D1E1F;

background-color: rgba(29,30,31,0.3);
background: rgba(29,30,31,0.3);
foreground: #C7D7D6;
border-color: #826B6C;

color0: #434546;
color1: #15171A;
color2: #2F1515;
color3: #381413;
color4: #615051;
color5: #9A382B;
color6: #476A68;
color7: #A7BEBC;
color8: #758584;
color9: #1C1F22;
color10: #3E1C1B;
color11: #4B1B19;
color12: #826B6C;
color13: #CD4A3A;
color14: #5F8D8A;
color15: #A7BEBC;
}

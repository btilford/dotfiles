 /* wallust template - colors-rofi */

* {
active-background: #867186;
active-foreground: #F2EBEE;
normal-background: #513E72;
normal-foreground: #F2EBEE;
urgent-background: #866E81;
urgent-foreground: #F2EBEE;

alternate-active-background: #86758C;
alternate-active-foreground: #F2EBEE;
alternate-normal-background: #513E72;
alternate-normal-foreground: #F2EBEE;
alternate-urgent-background: #513E72;
alternate-urgent-foreground: #F2EBEE;

selected-active-background: #867186;
selected-active-foreground: #513E72;
selected-normal-background: #867186;
selected-normal-foreground: #513E72;
selected-urgent-background: #86758C;
selected-urgent-foreground: #513E72;

background-color: rgba(81,62,114,0.3);
background: rgba(81,62,114,0.3);
foreground: #F2EBEE;
border-color: #867186;

color0: #FFFCFF;
color1: #736B80;
color2: #73697B;
color3: #736678;
color4: #736373;
color5: #74606F;
color6: #745E6A;
color7: #2C2736;
color8: #453C55;
color9: #867C97;
color10: #867892;

 /* wallust template - colors-rofi */

* {
active-background: #E12636;
active-foreground: #E2DDDD;
normal-background: #141414;
normal-foreground: #E2DDDD;
urgent-background: #E88153;
urgent-foreground: #E2DDDD;

alternate-active-background: #C72432;
alternate-active-foreground: #E2DDDD;
alternate-normal-background: #141414;
alternate-normal-foreground: #E2DDDD;
alternate-urgent-background: #141414;
alternate-urgent-foreground: #E2DDDD;

selected-active-background: #E12636;
selected-active-foreground: #141414;
selected-normal-background: #E12636;
selected-normal-foreground: #141414;
selected-urgent-background: #C72432;
selected-urgent-foreground: #141414;

background-color: rgba(20,20,20,0.3);
background: rgba(20,20,20,0.3);
foreground: #E2DDDD;
border-color: #E12636;

color0: #3B3B3B;
color1: #491419;
color2: #621D26;
color3: #961B25;
color4: #A91D28;
color5: #AE613E;
color6: #817676;
color7: #CDC6C6;
color8: #908A8B;
color9: #611B21;
color10: #832733;
color11: #C72432;
color12: #E12636;
color13: #E88153;
color14: #AC9D9E;
color15: #CDC6C6;
}

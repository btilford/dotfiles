 /* wallust template - colors-rofi */

* {
active-background: #E2523A;
active-foreground: #FFEFEA;
normal-background: #B91B01;
normal-foreground: #FFEFEA;
urgent-background: #DF513A;
urgent-foreground: #FFEFEA;

alternate-active-background: #E4573C;
alternate-active-foreground: #FFEFEA;
alternate-normal-background: #B91B01;
alternate-normal-foreground: #FFEFEA;
alternate-urgent-background: #B91B01;
alternate-urgent-foreground: #FFEFEA;

selected-active-background: #E2523A;
selected-active-foreground: #B91B01;
selected-normal-background: #E2523A;
selected-normal-foreground: #B91B01;
selected-urgent-background: #E4573C;
selected-urgent-foreground: #B91B01;

background-color: rgba(185,27,1,0.3);
background: rgba(185,27,1,0.3);
foreground: #FFEFEA;
border-color: #E2523A;

color0: #FFF7EE;
color1: #CCA559;
color2: #CD814F;
color3: #B94F3B;
color4: #B94C3A;
color5: #B64B3A;
color6: #953B3A;
color7: #715318;
color8: #B08225;
color9: #FDC963;
color10: #FE9956;

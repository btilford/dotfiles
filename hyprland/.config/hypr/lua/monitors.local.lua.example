-- Machine-local monitor descriptors. Copy to monitors.local.lua and edit.
--
--   cp monitors.local.lua.example monitors.local.lua
--
-- Two jobs:
--   1. define MON, the alias table other modules use (workspaces.lua,
--      keyboard.lua) so the tracked layout stays portable
--   2. place the monitors with hl.monitor()
--
-- Descriptors, serial suffix included, come from:
--   hyprctl monitors all | grep -E 'Monitor|description'
--
-- The serial is only strictly needed to disambiguate two panels of the same
-- model; with one panel of a model the prefix matches on its own.
--
-- Never commit monitors.local.lua — the name is reserved in .gitignore, and
-- scripts/no-local-values.sh fails a commit containing a `desc:` serial.

MON = {
    main = "desc: Vendor Inc. MODEL-A SERIAL1", -- centre display, workspace "Main"
    cli = "desc: Vendor Inc. MODEL-B SERIAL2", -- secondary, workspace "CLI1"
    ref_left = "desc: Vendor Inc. MODEL-C SERIAL3", -- portrait left, "RefLeft"
    ref_right = "desc: Vendor Inc. MODEL-C SERIAL4", -- portrait right, "RefRight"
}

-- transform: 0 normal, 1 = 90°, 2 = 180°, 3 = 270°
-- position is in logical (post-scale) coordinates

hl.monitor({ output = MON.ref_left, mode = "preferred", position = "-1440x0", scale = 1.5, transform = 1 })
hl.monitor({ output = MON.main, mode = "preferred", position = "0x300", scale = 1.5, transform = 0 })
hl.monitor({ output = MON.cli, mode = "preferred", position = "0x1740", scale = 1.5, transform = 0 })
hl.monitor({ output = MON.ref_right, mode = "preferred", position = "2560x0", scale = 1.5, transform = 3 })
